ENV=development

# PostgreSQL local. Remplacez MOT_DE_PASSE_POSTGRES par votre mot de passe.
DATABASE_URL=postgresql+psycopg://postgres:MOT_DE_PASSE_POSTGRES@localhost:5432/threatwatch

# A changer en production (chaine aleatoire longue).
SESSION_SECRET_KEY=change-moi-en-production
SESSION_MAX_AGE=28800
SESSION_HTTPS_ONLY=false
