ENV=development

# PostgreSQL local. Remplacez MOT_DE_PASSE_POSTGRES par votre mot de passe.
DATABASE_URL=postgresql+psycopg://postgres:MOT_DE_PASSE_POSTGRES@localhost:5432/threatwatch

# A changer en production (chaine aleatoire longue).
SESSION_SECRET_KEY=change-moi-en-production
SESSION_MAX_AGE=28800
SESSION_HTTPS_ONLY=false

# Collecte publique DGSSI.
DGSSI_SOURCE_URL=https://www.dgssi.gov.ma/fr/bulletins-securite
DGSSI_HTTP_TIMEOUT=30
DGSSI_USER_AGENT=ThreatWatch/0.2 (+https://github.com/inasalilou/ThreatWatch)

# Synchronisation automatique DGSSI.
DGSSI_SYNC_ENABLED=false
DGSSI_SYNC_INTERVAL_MINUTES=60
DGSSI_SYNC_ON_STARTUP=false
